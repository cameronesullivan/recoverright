# Copy this file to .env.local and fill in your values.
# .env.local is ignored by git, so your key stays on your computer.

# Required: your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional: which OpenAI model to use. It must support image and PDF input
# and Structured Outputs. Defaults to gpt-6.1-sol if left blank.
OPENAI_MODEL=

# Optional: model for the short guided-session coach messages.
# Defaults to gpt-5-mini if left blank. OpenAI plans to shut down gpt-5-mini on
# December 11, 2026; its recommended replacement is gpt-5.6-terra.
OPENAI_COACH_MODEL=
